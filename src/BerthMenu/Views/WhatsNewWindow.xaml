<Window x:Class="BerthMenu.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in BerthMenu"
        Width="520" Height="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Two pages in one window (WhatsNewWindow.xaml.cs fills them in):
         What's new — the release notes from CHANGELOG.md, newest first. Opened from
           the "BerthMenu updated" notification, the tray menu and Settings.
         Tips — Resources/Tips.md. Opened from the tray menu and Settings.
         The link at the bottom left switches between them. -->
    <Grid Margin="20,16,8,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="NotesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel x:Name="NotesPanel"/>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,12,12,0">
            <TextBlock x:Name="SwitchLink" VerticalAlignment="Center" HorizontalAlignment="Left"
                       Foreground="{DynamicResource AccentBrush}" TextDecorations="Underline" Cursor="Hand"
                       MouseLeftButtonUp="SwitchLink_Click"/>
            <Button Content="Close" Width="80" Padding="0,2,0,4" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
