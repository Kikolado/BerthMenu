<Window x:Class="BerthMenu.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BerthMenu Settings"
        Width="1000" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Compact, single-screen layout: three columns of titled cards, one row per
         setting. The long explanatory paragraphs that used to sit under nearly
         every control now live in ToolTips on those controls instead — same
         information, hover to read it, zero vertical space — which is what lets
         everything fit without scrolling. Label/control rows share fixed label
         widths (see LabelColumnWidth) so controls line up down each card.

         SettingsScrollViewer is kept only as a backstop for unusually short
         screens (see SettingsWindow.xaml.cs's constructor, which caps it to the
         real work area): at normal sizes the content fits and no scrollbar shows. -->
    <Window.Resources>
        <GridLength x:Key="LabelColumnWidth">100</GridLength>
        <!-- The Layout card's labels get a little more room (and its dropdowns a
             little less), so "Column alignment" isn't crowded. -->
        <GridLength x:Key="LayoutLabelColumnWidth">116</GridLength>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10,14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <!-- BasedOn the app-wide implicit styles (Styles.xaml), which fix these
             controls' text color on the dark theme — just adding row spacing. -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search: highlights the settings that match and fades the cards with
             none (SettingsWindow.xaml.cs, "Search settings"). Ctrl+F jumps here. -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SettingsSearchBox" Style="{StaticResource ThemedTextBox}" Padding="26,5,8,5"
                     TextChanged="SettingsSearchBox_TextChanged" PreviewKeyDown="SettingsSearchBox_PreviewKeyDown"
                     ToolTip="Type a word like &quot;border&quot; or &quot;blur&quot; to find a setting. Ctrl+F"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12"
                       Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock x:Name="SettingsSearchPlaceholder" Text="Search settings"
                       Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock x:Name="SettingsSearchStatus" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Grid>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= Column 1 ================= -->
                <StackPanel Grid.Column="0">

                    <!-- Activation -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Activation" Style="{StaticResource CardHeader}"/>
                            <RadioButton x:Name="HotkeyWinRadio" GroupName="Hotkey" Content="Windows key"
                                         ToolTip="Fully replaces the native Start Menu."/>
                            <RadioButton x:Name="HotkeyShiftWinRadio" GroupName="Hotkey" Content="Shift + Windows key"
                                         ToolTip="Leaves the plain Windows key opening the native Start Menu."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="HotkeyCustomRadio" Grid.Column="0" GroupName="Hotkey" Content="Custom"
                                             Margin="0,0,10,0" Checked="HotkeyCustomRadio_Checked"/>
                                <!-- Click-to-capture field for the Custom keybind — see
                                     SettingsWindow.xaml.cs CustomKeybindBox_GotFocus/_PreviewKeyDown. -->
                                <TextBox x:Name="CustomKeybindBox" Grid.Column="1"
                                         Padding="6,3"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         HorizontalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         Background="{DynamicResource TileHoverBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderThickness="0"
                                         ToolTip="Click, then press a key combination. A modifier (Ctrl/Alt/Shift/Win) is optional; without one, pick a key you don't otherwise type (like a spare function key), since BerthMenu catches every press of it."
                                         GotKeyboardFocus="CustomKeybindBox_GotFocus"
                                         LostKeyboardFocus="CustomKeybindBox_LostFocus"
                                         PreviewKeyDown="CustomKeybindBox_PreviewKeyDown">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                            <CheckBox x:Name="ReplaceStartButtonCheck" Content="Taskbar Start button opens BerthMenu" Margin="0,8,0,4"/>
                            <CheckBox x:Name="ShowTaskbarOverFullscreenCheck" Content="Show the taskbar over fullscreen apps"
                                      ToolTip="Like the real Start Menu: opening BerthMenu over a fullscreen app or game also brings the taskbar forward, and it goes back behind the app when BerthMenu closes. Doesn't apply to an auto-hidden taskbar or exclusive-fullscreen games."/>
                        </StackPanel>
                    </Border>

                    <!-- Startup -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Startup" Style="{StaticResource CardHeader}"/>
                            <CheckBox x:Name="AutoStartCheck" Content="Start when I sign in"/>
                            <CheckBox x:Name="ExplorerPinMenuCheck" Content="&quot;Pin to BerthMenu&quot; in File Explorer"
                                      ToolTip="Adds &quot;Pin to BerthMenu&quot; when you right-click a file or folder in File Explorer. On Windows 11 it's under &quot;Show more options&quot;."/>
                            <CheckBox x:Name="StartAsAdminCheck" Content="Start as Admin"
                                      ToolTip="Lets the shortcut and Start-button replacement work over apps that run as Admin, like some games and Task Manager. Windows asks for permission once, when you save; after that BerthMenu starts as Admin without asking."/>
                            <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AdminStatusText" Grid.Column="0" Style="{StaticResource RowLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <Button x:Name="RestartAsAdminButton" Grid.Column="1" Content="Restart as Admin" Click="RestartAsAdmin_Click"
                                        ToolTip="Restarts BerthMenu as Administrator now. Unsaved changes in this window are discarded — Save first to keep them."/>
                            </Grid>
                            <!-- Updates — see Services/Updater.cs. -->
                            <CheckBox x:Name="AutoUpdateCheck" Content="Update automatically" Margin="0,8,0,4"
                                      ToolTip="Checks for new versions of BerthMenu and installs them while the dock is closed."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateStatusText" Grid.Column="0" Style="{StaticResource RowLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                <Button x:Name="CheckUpdatesButton" Grid.Column="1" Content="Check for updates" Click="CheckUpdates_Click"/>
                            </Grid>
                            <!-- Automatic settings backups — see ConfigService (Backups). -->
                            <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Two lines, so the date fits beside the button; hover for the
                                     full date (Background makes the whole area hoverable). -->
                                <StackPanel x:Name="BackupStatusPanel" Grid.Column="0" VerticalAlignment="Center"
                                            Margin="0,0,8,0" Background="Transparent">
                                    <TextBlock x:Name="BackupStatusLabel" Text="Last backup"
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="BackupStatusText" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button x:Name="RestoreBackupButton" Grid.Column="1" Content="Restore a backup…" Click="RestoreBackup_Click"
                                        ToolTip="Your settings and pinned apps are backed up automatically, once a day when something changes. Pick one to go back to it."/>
                            </Grid>
                            <!-- Export / Import / Reset — see ConfigService. -->
                            <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Content="Export…" Margin="0,0,6,0" Click="ExportSettings_Click"
                                        ToolTip="Save your settings and pinned apps (with their icons) to a file, to bring them back later or onto another PC."/>
                                <Button Content="Import…" Margin="0,0,6,0" Click="ImportSettings_Click"
                                        ToolTip="Replace your settings and pinned apps with ones exported earlier. BerthMenu restarts."/>
                                <Button Content="Reset…" Click="ResetSettings_Click"
                                        ToolTip="Start over like a new install: removes your pinned apps and puts every setting back to its default. BerthMenu restarts."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Menu bar -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Menu Bar" Style="{StaticResource CardHeader}"/>
                            <!-- Hide the menu bar first: it grays out everything below it. -->
                            <CheckBox x:Name="HideMenuBarCheck" Content="Hide the menu bar"
                                      Checked="HideMenuBarCheck_CheckedChanged" Unchecked="HideMenuBarCheck_CheckedChanged"/>
                            <CheckBox x:Name="HideMenuBarDividerCheck" Content="Hide menu bar divider line"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Position" Style="{StaticResource RowLabel}"/>
                                <!-- Ordered to match MenuBarPlacement. -->
                                <ComboBox x:Name="MenuBarPositionCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Bottom"/>
                                    <ComboBoxItem Content="Top"/>
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Right"/>
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="FlipMenuBarOrderCheck" Content="Flip icon order"/>
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <CheckBox x:Name="ShowUserButtonCheck" Content="User Icon"/>
                                <CheckBox x:Name="ShowAddButtonCheck" Content="Add (+)"/>
                                <CheckBox x:Name="ShowNativeStartMenuButtonCheck" Content="Start Menu"/>
                                <CheckBox x:Name="ShowTaskManagerButtonCheck" Content="Task Manager"/>
                                <CheckBox x:Name="ShowVolumeMixerButtonCheck" Content="Volume Mixer"/>
                                <CheckBox x:Name="ShowFileExplorerButtonCheck" Content="File Explorer"/>
                                <CheckBox x:Name="ShowCalculatorButtonCheck" Content="Calculator"/>
                                <CheckBox x:Name="ShowSettingsButtonCheck" Content="Settings"
                                          ToolTip="Settings stays reachable even if its button is hidden: right-click the tray icon → Settings."/>
                                <CheckBox x:Name="ShowPowerButtonCheck" Content="Power"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Column 2 ================= -->
                <StackPanel Grid.Column="2">

                    <!-- Layout -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Layout" Style="{StaticResource CardHeader}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dock Position" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="PositionCombo" Grid.Column="1" SelectedIndex="0">
                                    <!-- Grouped display order (top, middle, bottom — reading order) rather than
                                         DockPosition's own append-only declaration order —
                                         SettingsWindow.xaml.cs's PositionComboOrder maps index to
                                         value. Keep the two in sync if either changes. -->
                                    <ComboBoxItem Content="Top left"/>
                                    <ComboBoxItem Content="Top center"/>
                                    <ComboBoxItem Content="Top right"/>
                                    <ComboBoxItem Content="Middle left"/>
                                    <ComboBoxItem Content="Middle center"/>
                                    <ComboBoxItem Content="Middle right"/>
                                    <ComboBoxItem Content="Bottom left"/>
                                    <ComboBoxItem Content="Bottom center"/>
                                    <ComboBoxItem Content="Bottom right"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Animation" Style="{StaticResource RowLabel}"/>
                                <!-- Item order matches the DockAnimation enum. -->
                                <ComboBox x:Name="DockAnimationCombo" Grid.Column="1" SelectedIndex="0"
                                          ToolTip="How the dock opens and closes. Slide: it comes in from the screen edge it sits against (from behind the taskbar at the bottom). Fade: it fades in and out where it is; Fade (fast) does it in half the time. None: it just appears.">
                                    <!-- Order differs from DockAnimation's values: see AnimationComboOrder. -->
                                    <ComboBoxItem Content="Slide"/>
                                    <ComboBoxItem Content="Fade"/>
                                    <ComboBoxItem Content="Fade (fast)"/>
                                    <ComboBoxItem Content="None"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Icon direction" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="LayoutDirectionCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="LayoutDirectionCombo_SelectionChanged">
                                    <ComboBoxItem Content="Rows (across)"/>
                                    <ComboBoxItem Content="Columns (down)"/>
                                </ComboBox>
                            </Grid>

                            <!-- Only one of these two shows, matching Icon direction (see
                                 SettingsWindow.xaml.cs UpdateAlignmentRows). -->
                            <Grid x:Name="RowAlignmentRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Row alignment" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="RowAlignmentCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                </ComboBox>
                            </Grid>
                            <Grid x:Name="ColumnAlignmentRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Column alignment" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ColumnAlignmentCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Top"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Bottom"/>
                                </ComboBox>
                            </Grid>

                            <!-- Gap between categories. One slider per Icon direction (each
                                 has its own original spacing), only the matching one shown —
                                 see SettingsWindow.xaml.cs UpdateAlignmentRows. -->
                            <Grid x:Name="RowSpacingRow" Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Category spacing" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="RowSpacingSlider" Grid.Column="1"
                                        Minimum="0" Maximum="48"
                                        IsSnapToTickEnabled="True" TickFrequency="2"
                                        ValueChanged="CategorySpacingSlider_ValueChanged"/>
                                <TextBlock x:Name="RowSpacingValueText" Grid.Column="2" Text="2 px" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <Grid x:Name="ColumnSpacingRow" Style="{StaticResource Row}" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Category spacing" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="ColumnSpacingSlider" Grid.Column="1"
                                        Minimum="0" Maximum="48"
                                        IsSnapToTickEnabled="True" TickFrequency="2"
                                        ValueChanged="CategorySpacingSlider_ValueChanged"/>
                                <TextBlock x:Name="ColumnSpacingValueText" Grid.Column="2" Text="16 px" Style="{StaticResource ValueText}"/>
                            </Grid>

                            <CheckBox x:Name="SnapDockWidthCheck" Content="Snap dock width to the icon grid"
                                      ToolTip="Dragging the dock's right edge jumps between whole columns of icons, so rows end without a gap. Turn off to resize smoothly. Doesn't apply to the Columns layout."/>
                            <CheckBox x:Name="OpenFoldersInDockCheck" Content="Open pinned folders inside BerthMenu"
                                      ToolTip="Clicking a pinned folder (like Downloads) shows what's in it right in the dock, with Open in File Explorer one click away. Shift+click opens File Explorer instead."/>

                            <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LayoutLabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dock size" Style="{StaticResource RowLabel}"/>
                                <Button Grid.Column="1" HorizontalAlignment="Left" Content="Reset to smallest" Click="ResetDockSize_Click"/>
                            </Grid>
                            <TextBlock x:Name="ResetDockSizeStatusText"
                                       Margin="116,2,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent: the automatic sections at the bottom of the dock. -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recent" Style="{StaticResource CardHeader}"/>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ShowNewAppsCheck" Content="Recently added apps"/>
                                <ComboBox x:Name="NewAppsCountCombo" Grid.Column="1" Width="56" SelectedIndex="4"
                                          IsEnabled="{Binding IsChecked, ElementName=ShowNewAppsCheck}"
                                          ToolTip="How many recently added apps to show">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="11"/>
                                    <ComboBoxItem Content="12"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ShowRecentAppsCheck" Content="Recently used apps"/>
                                <ComboBox x:Name="RecentAppsCountCombo" Grid.Column="1" Width="56" SelectedIndex="4"
                                          IsEnabled="{Binding IsChecked, ElementName=ShowRecentAppsCheck}"
                                          ToolTip="How many recently used apps to show">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="11"/>
                                    <ComboBoxItem Content="12"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ShowRecentFilesCheck" Content="Recently used files"/>
                                <ComboBox x:Name="RecentFilesCountCombo" Grid.Column="1" Width="56" SelectedIndex="4"
                                          IsEnabled="{Binding IsChecked, ElementName=ShowRecentFilesCheck}"
                                          ToolTip="How many recently used files to show">
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                    <ComboBoxItem Content="11"/>
                                    <ComboBoxItem Content="12"/>
                                </ComboBox>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show as" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="RecentSectionsCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Separate sections"/>
                                    <ComboBoxItem Content="One combined section"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Item Size (icon size and text sizes) -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Item Size" Style="{StaticResource CardHeader}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Icon size" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="IconSizeSlider" Grid.Column="1"
                                        Minimum="48" Maximum="160"
                                        IsSnapToTickEnabled="True" TickFrequency="4"
                                        ValueChanged="IconSizeSlider_ValueChanged"/>
                                <TextBlock x:Name="IconSizeValueText" Grid.Column="2" Text="92 px" Style="{StaticResource ValueText}"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Category names" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="CategoryFontSizeSlider" Grid.Column="1"
                                        Minimum="10" Maximum="24"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="CategoryFontSizeSlider_ValueChanged"/>
                                <TextBlock x:Name="CategoryFontSizeValueText" Grid.Column="2" Text="16 px" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="100,0,0,4">
                                <CheckBox x:Name="BoldCategoryNamesCheck" Content="Bold" Margin="0,2,18,2"/>
                                <CheckBox x:Name="HideCategoryBannersCheck" Content="Hide" Margin="0,2"/>
                            </StackPanel>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Icon names" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="IconNameFontSizeSlider" Grid.Column="1"
                                        Minimum="8" Maximum="18"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="IconNameFontSizeSlider_ValueChanged"/>
                                <TextBlock x:Name="IconNameFontSizeValueText" Grid.Column="2" Text="11 px" Style="{StaticResource ValueText}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="100,0,0,0">
                                <CheckBox x:Name="BoldIconNamesCheck" Content="Bold" Margin="0,2,18,2"/>
                                <CheckBox x:Name="HideIconNamesCheck" Content="Hide" Margin="0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Column 3 ================= -->
                <StackPanel Grid.Column="4">

                    <!-- Background -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Background" Style="{StaticResource CardHeader}"/>

                            <Grid Style="{StaticResource Row}"
                                  ToolTip="0% opacity allows mouse to click through BerthMenu.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="OpacitySlider" Grid.Column="1"
                                        Minimum="0" Maximum="100"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="OpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="OpacityValueText" Grid.Column="2" Text="100%" Style="{StaticResource ValueText}"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}"
                                  ToolTip="The dock's background color. Opacity, frosted glass and a picture still apply on top of it.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Color" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="BackgroundColorCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="Match theme"/>
                                    <ComboBoxItem Content="Custom color"/>
                                </ComboBox>
                                <Button x:Name="BackgroundColorSwatch" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                        Width="26" Height="26" Margin="6,0,0,0" Visibility="Collapsed"
                                        Click="ColorSwatch_Click" ToolTip="Change the color"/>
                            </Grid>

                            <CheckBox x:Name="FrostedBackgroundCheck" Content="Frosted glass (blur what's behind)"
                                      ToolTip="Below 100% opacity, shows a soft blur of whatever's behind the dock instead of plain see-through. Works with a picture background too."/>

                            <Grid Style="{StaticResource Row}"
                                  ToolTip="Frosted glass may show square corners on some systems.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Frost tint" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="FrostTintCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Match theme"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Clear (no tint)"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource Row}" Margin="0,6,0,3"
                                  ToolTip="Shows a picture behind the icons instead of a plain color. It's copied into BerthMenu's settings folder, so moving the original later won't break it.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Image" Style="{StaticResource RowLabel}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="BackgroundImageStatusText" Grid.Column="1" Text="None"
                                           Style="{StaticResource RowLabel}" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <Button Grid.Column="2" Content="Choose…" Click="ChooseBackgroundImage_Click"/>
                                <Button Grid.Column="3" x:Name="ClearBackgroundImageButton" Content="Remove" Margin="6,0,0,0" Click="ClearBackgroundImage_Click"/>
                            </Grid>

                            <CheckBox x:Name="FitBackgroundImageCheck" Content="Fit whole image (no cropping)"/>
                        </StackPanel>
                    </Border>

                    <!-- Look -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Look" Style="{StaticResource CardHeader}"/>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="Follow Windows"/>
                                    <ComboBoxItem Content="Light"/>
                                    <ComboBoxItem Content="Dark"/>
                                </ComboBox>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Text color" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="TextColorCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="Default (follows theme)"/>
                                    <ComboBoxItem Content="Black"/>
                                    <ComboBoxItem Content="White"/>
                                    <ComboBoxItem Content="Custom color"/>
                                </ComboBox>
                                <Button x:Name="TextColorSwatch" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                        Width="26" Height="26" Margin="6,0,0,0" Visibility="Collapsed"
                                        Click="ColorSwatch_Click" ToolTip="Change the color"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}"
                                  ToolTip="The highlight color: hovering over and pressing tiles, the bar under open apps, the Alt+number badges, and the outline of a focused box. Theme icon tiles use it too.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Accent color" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="AccentColorCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="Match theme"/>
                                    <ComboBoxItem Content="Windows accent color"/>
                                    <ComboBoxItem Content="Custom color"/>
                                </ComboBox>
                                <Button x:Name="AccentColorSwatch" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                        Width="26" Height="26" Margin="6,0,0,0" Visibility="Collapsed"
                                        Click="ColorSwatch_Click" ToolTip="Change the color"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}"
                                  ToolTip="Gives every tile the soft square background it normally only shows on hover — helps icons with transparent artwork stand out.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ShowIconBackgroundCheck" Content="Icon tiles" Margin="0"/>
                                <ComboBox x:Name="IconBackgroundColorCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="ColorCombo_SelectionChanged">
                                    <ComboBoxItem Content="Theme (matches hover)"/>
                                    <ComboBoxItem Content="Black"/>
                                    <ComboBoxItem Content="White"/>
                                    <ComboBoxItem Content="Custom color"/>
                                </ComboBox>
                                <Button x:Name="IconBackgroundColorSwatch" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                        Width="26" Height="26" Margin="6,0,0,0" Visibility="Collapsed"
                                        Click="ColorSwatch_Click" ToolTip="Change the color"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}"
                                  IsEnabled="{Binding IsChecked, ElementName=ShowIconBackgroundCheck}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tile opacity" Style="{StaticResource RowLabel}"/>
                                <Slider x:Name="IconBackgroundOpacitySlider" Grid.Column="1"
                                        Minimum="10" Maximum="100"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        ValueChanged="IconBackgroundOpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="IconBackgroundOpacityValueText" Grid.Column="2" Text="100%" Style="{StaticResource ValueText}"/>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Border" Style="{StaticResource RowLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <CheckBox x:Name="BoldBorderCheck" Content="Bold" Margin="0,0,18,0"/>
                                    <CheckBox x:Name="HideBorderCheck" Content="Remove" Margin="0"
                                              Checked="HideBorderCheck_CheckedChanged" Unchecked="HideBorderCheck_CheckedChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Border color" Style="{StaticResource RowLabel}"/>
                                <ComboBox x:Name="BorderColorCombo" Grid.Column="1" SelectedIndex="0"
                                          SelectionChanged="ColorCombo_SelectionChanged"
                                          ToolTip="Match theme: a soft gray, or white/black when Bold. White, Black and a custom color work at either thickness, and color the menu bar's divider line too.">
                                    <ComboBoxItem Content="Match theme"/>
                                    <ComboBoxItem Content="White"/>
                                    <ComboBoxItem Content="Black"/>
                                    <ComboBoxItem Content="Custom color"/>
                                </ComboBox>
                                <Button x:Name="BorderColorSwatch" Grid.Column="2" Style="{StaticResource SwatchButton}"
                                        Width="26" Height="26" Margin="6,0,0,0" Visibility="Collapsed"
                                        Click="ColorSwatch_Click" ToolTip="Change the color"/>
                            </Grid>

                            <CheckBox x:Name="ShowRunningIndicatorCheck" Content="Show a bar under open apps"
                                      ToolTip="A small line under pinned apps that are running right now, like the taskbar."/>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Search" Style="{StaticResource CardHeader}"/>
                            <CheckBox x:Name="HideSearchBarCheck" Content="Hide search bar until I start typing"/>
                            <CheckBox x:Name="SearchFilesCheck" Content="Include files"/>
                            <CheckBox x:Name="SearchCalculatorCheck" Content="Calculator"
                                      ToolTip="Type math like 125*4 or 15% of 80 to see the answer. Click it (or press Enter) to copy it."/>
                            <CheckBox x:Name="SearchRunCheck" Content="Run commands and open paths"
                                      ToolTip="Like the Windows Run box: type a command (cmd, notepad, ping 8.8.8.8) or a path (C:\Users, %AppData%) and press Enter. Ctrl+Shift+Enter runs it as administrator."/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LabelColumnWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SearchWebCheck" Content="Web search" Margin="0"
                                          ToolTip="Adds a &quot;Search the web for …&quot; result that opens your browser. Nothing is sent while you type — only when you click it."/>
                                <ComboBox x:Name="WebSearchEngineCombo" Grid.Column="1" SelectedIndex="0"
                                          IsEnabled="{Binding IsChecked, ElementName=SearchWebCheck}">
                                    <ComboBoxItem Content="Google"/>
                                    <ComboBoxItem Content="Bing"/>
                                    <ComboBoxItem Content="DuckDuckGo"/>
                                </ComboBox>
                            </Grid>
                            <!-- Right-click a search result → Hide from search; brought
                                 back here (HiddenSearchDialog). -->
                            <Grid Style="{StaticResource Row}" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HiddenSearchText" Style="{StaticResource RowLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                <Button x:Name="ManageHiddenButton" Grid.Column="1" Content="Manage…" Click="ManageHidden_Click"
                                        ToolTip="Things you hid from search with right-click → Hide from search. Bring them back here."/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="ValidationErrorText"
                   Grid.Row="2"
                   Foreground="#E05252"
                   Margin="0,4,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Margin="10,0,0,0" Opacity="0.75" Text="What's new"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextDecorations="Underline" Cursor="Hand"
                           MouseLeftButtonUp="WhatsNew_Click"/>
                <TextBlock Margin="10,0,0,0" Opacity="0.75" Text="Tips"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextDecorations="Underline" Cursor="Hand"
                           MouseLeftButtonUp="Tips_Click"/>
                <TextBlock Margin="10,0,0,0" Opacity="0.75" Text="Report a problem"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextDecorations="Underline" Cursor="Hand"
                           ToolTip="Opens a new GitHub issue with your BerthMenu and Windows versions and recent errors filled in."
                           MouseLeftButtonUp="ReportProblem_Click"/>
                <TextBlock Margin="10,0,0,0" Opacity="0.75" Text="GitHub"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextDecorations="Underline" Cursor="Hand"
                           ToolTip="BerthMenu's page on GitHub"
                           MouseLeftButtonUp="GitHub_Click"/>
                <!-- "Update 0.9.1 available" once a newer version is found — click to
                     install it (see SettingsWindow.xaml.cs UpdateUpdaterStatus). -->
                <TextBlock x:Name="UpdateAvailableText" Margin="10,0,0,0" Opacity="0.75"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextDecorations="Underline" Cursor="Hand" Visibility="Collapsed"
                           MouseLeftButtonUp="UpdateAvailable_Click"/>
                <TextBlock x:Name="FooterStatusText" Margin="16,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshAppsButton" Content="Refresh Apps" Width="110" Padding="0,3,0,5" Margin="0,0,24,0" Click="RefreshApps_Click"
                        ToolTip="Re-reads your installed apps — for an app that isn't showing up in search or the Add picker, like one you just installed."/>
                <Button Content="Cancel" Width="90" Padding="0,3,0,5" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Apply" Width="90" Padding="0,3,0,5" Margin="0,0,8,0" Click="Apply_Click"/>
                <Button Content="Save &amp; Close" MinWidth="110" Padding="12,3,12,5" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
