<Window x:Class="BerthMenu.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Closing Settings with changes that weren't saved (UnsavedChangesDialog.Ask).
         Closing this window or pressing Esc goes back to Settings. -->
    <StackPanel Margin="16">
        <TextBlock Text="Save your changes?" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="You changed some settings but didn't save them."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close without saving" Padding="12,2,12,4" Margin="0,0,8,0" Click="Discard_Click"/>
            <Button Content="Save changes" Padding="12,2,12,4" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
