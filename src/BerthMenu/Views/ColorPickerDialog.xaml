<Window x:Class="BerthMenu.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a color"
        Width="404" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- The "Custom color" picker for Settings' color choices (text, icon tiles,
         border, background, accent). Swatches, your Windows accent color, a hex
         box, and More colors… for the full Windows color picker. -->
    <StackPanel Margin="16">
        <!-- 10 per row, filled in by the code-behind (see Palette). -->
        <WrapPanel x:Name="PalettePanel" Width="340" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button x:Name="WindowsAccentSwatch" Style="{StaticResource SwatchButton}"
                    Click="Swatch_Click" ToolTip="Your Windows accent color"/>
            <TextBlock Text="Windows accent color" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PreviewBorder" Width="44" Height="28" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{DynamicResource DividerBrush}"/>
            <TextBlock Grid.Column="1" Text="Hex" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="HexBox" Grid.Column="2" Width="96" Padding="6,4" MaxLength="7"
                     Style="{StaticResource ThemedTextBox}" TextChanged="HexBox_TextChanged"/>
            <Button Grid.Column="3" Content="More colors…" HorizontalAlignment="Right" Padding="10,2,10,4"
                    Click="MoreColors_Click" ToolTip="Opens the Windows color picker for any color"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Padding="0,2,0,4" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="OK" Width="80" Padding="0,2,0,4" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
