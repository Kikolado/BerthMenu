<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Segoe Fluent Icons ships with Windows 11 (falls back to Segoe MDL2 Assets on
         Windows 10) and gives us crisp vector glyphs for gear/power/explorer/etc.
         without shipping any image assets. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A square, icon-only button used in the bottom bar (settings gear, power, explorer). -->
    <Style x:Key="BottomBarIconButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TilePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An app tile in the icon grid: icon on top, name below, hover/press feedback.
         Also used for the plain-text power-flyout items (Lock/Sleep/etc.) — those rely
         on this explicit Foreground Setter rather than inherited color, because Popup
         content in WPF doesn't reliably inherit Foreground from its logical parent
         (a well-known WPF quirk: Popup renders in a separate visual-tree root). Without
         this Setter those buttons fell back to Button's built-in black default, which
         read as black-on-black against a dark theme's flyout background. -->
    <Style x:Key="AppTileButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TilePressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin, modern scrollbar — WPF's default ScrollBar is a bulky ~17px track
         with big up/down arrow buttons; this replaces it everywhere (an implicit,
         unkeyed Style targeting ScrollBar, so it applies to every ScrollBar in the
         app automatically — the dock's own category list and SettingsWindow's
         ScrollViewer alike — with nothing extra to opt in anywhere) with a slim
         8px track, no arrow buttons, and a soft rounded thumb that's mostly
         invisible until hovered or dragged, closer to a modern browser/Fluent-style
         scrollbar than the classic chunky Windows one. -->
    <Style x:Key="SlimScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource SecondaryTextBrush}" CornerRadius="3" Opacity="0.3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.55"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit (unkeyed) styles, so these apply automatically to every CheckBox
         and RadioButton in the app with nothing to opt in anywhere — same pattern
         as the unkeyed ScrollBar style below. Without this, both controls fall
         back to their own built-in default Foreground (tied to the OS's own
         light-mode control-text color) instead of inheriting SettingsWindow's
         Foreground="{DynamicResource PrimaryTextBrush}", because a control's own
         style setter always wins over inherited value in WPF — the exact same
         "control's own built-in black default beats inheritance" issue
         AppTileButton's own comment above already describes for Button inside a
         Popup, just showing up here for CheckBox/RadioButton and without needing
         a Popup to trigger it. Read as black-on-near-black text in every checkbox
         and radio button label in Settings until this was added. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style TargetType="ScrollBar">
        <!-- 8px across its short side only: Width for a vertical scrollbar, Height
             for a horizontal one (the trigger at the bottom). This used to set both
             Width and Height to 8 for every scrollbar, on the theory that the
             container would stretch the long side anyway — it doesn't, an explicit
             Height wins, so a vertical scrollbar came out as an 8x8 square with a
             tiny unusable thumb in it (the little dash at the right of the dock and
             the Add to StartDock list). -->
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.Thumb>
                                <!-- At least 24px long, so it stays easy to grab in a long list. -->
                                <Thumb x:Name="SlimThumb" Style="{StaticResource SlimScrollBarThumb}" Margin="2" MinHeight="24"/>
                            </Track.Thumb>
                            <!-- No arrow buttons at either end (a slim scrollbar has none) —
                                 these two RepeatButtons exist only so clicking the track above/
                                 below the thumb still pages the view, invisible either way. -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- IsDirectionReversed="True" above is the correct convention for a
                             vertical scrollbar (dragging the thumb down scrolls down); a
                             horizontal one needs the opposite so dragging right scrolls right. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="SlimThumb" Property="MinHeight" Value="0"/>
                            <Setter TargetName="SlimThumb" Property="MinWidth" Value="24"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
