<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme (default). ThemeService/App swap this dictionary out for
        Theme.Dark.xaml at runtime (see App.xaml.cs ApplyTheme) — every brush key here
        must have a matching key in Theme.Dark.xaml.
    -->

    <Color x:Key="DockBackgroundColor">#F3F3F3</Color>
    <Color x:Key="DockBorderColor">#D9D9D9</Color>
    <Color x:Key="TileHoverColor">#E5E5E5</Color>
    <Color x:Key="TilePressedColor">#D6D6D6</Color>
    <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
    <Color x:Key="SecondaryTextColor">#5D5D5D</Color>
    <Color x:Key="AccentColor">#0067C0</Color>
    <Color x:Key="DividerColor">#D0D0D0</Color>

    <SolidColorBrush x:Key="DockBackgroundBrush" Color="{StaticResource DockBackgroundColor}"/>
    <SolidColorBrush x:Key="DockBorderBrush" Color="{StaticResource DockBorderColor}"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="{StaticResource TileHoverColor}"/>
    <SolidColorBrush x:Key="TilePressedBrush" Color="{StaticResource TilePressedColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <!-- BottomBarBackgroundBrush was removed here: the menu bar (MainWindow.xaml's
         MenuBarRow) no longer paints any background of its own at all — it shows
         BackgroundBorder, shared with the rest of the dock, straight through instead
         of its own, separately-configured color. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

</ResourceDictionary>
