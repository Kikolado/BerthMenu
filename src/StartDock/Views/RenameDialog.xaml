<Window x:Class="StartDock.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Small name prompt for a pinned tile's right-click → Rename (see
         MainWindow.RenameTile_Click). Enter saves, Esc cancels. -->
    <StackPanel Margin="16">
        <TextBlock Text="Name" Margin="0,0,0,6"/>
        <TextBox x:Name="NameBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Padding="0,3" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="80" Padding="0,3" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
