<Window x:Class="StartDock.Views.TilePropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Right-click a pinned tile → Properties...: what it opens and how
         (see MainWindow.TileProperties_Click and AppLauncher.Launch). -->
    <StackPanel Margin="16">
        <TextBlock Text="Name" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"/>

        <TextBlock Text="Search keywords" Margin="0,12,0,4"/>
        <TextBox x:Name="KeywordsBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"/>
        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Extra words that find this tile in search, like &quot;ps&quot; for PowerShell. Separate them with spaces or commas."/>

        <TextBlock Text="Opens" Margin="0,12,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"
                     TextChanged="TargetBox_TextChanged"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseTarget_Click"/>
        </Grid>

        <TextBlock Text="Arguments" Margin="0,12,0,4"/>
        <TextBox x:Name="ArgumentsBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"/>
        <TextBlock x:Name="ArgumentsNote" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"/>

        <TextBlock Text="Start in" Margin="0,12,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="StartInBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"/>
            <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseStartIn_Click"/>
        </Grid>

        <CheckBox x:Name="RunAsAdminCheck" Content="Always run as administrator" Margin="0,14,0,0"/>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#E05252" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Padding="0,3" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="80" Padding="0,3" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
