<Window x:Class="StartDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartDock.Views"
        Title="StartDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        Visibility="Hidden"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One tile in the grid — an app/folder, or a transient search result
             (see DockIconViewModel). Shared between a category's own icons and
             the flat search/folder view (see IconItemsControl below) so this
             sizeable template only needs to exist in one place. -->
        <DataTemplate x:Key="IconTileTemplate">
            <!-- TileBg: the persistent tile background (AppConfig.ShowIconBackground),
                 drawn as its own layer behind the button rather than as the button's
                 Background, so it can be faded on its own (AppConfig.IconBackgroundOpacity)
                 without fading the icon and name with it. Same 4px rounding as
                 AppTileButton's hover highlight, which still draws on top at full
                 strength on hover. Not hit-testable — clicks always go to the button. -->
            <Grid Margin="4">
            <Border x:Name="TileBg" CornerRadius="4" Background="Transparent" IsHitTestVisible="False"
                    Opacity="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconTileOpacity}"/>
            <Button x:Name="TileButton"
                    Style="{StaticResource AppTileButton}"
                    Width="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconSize}"
                    Height="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconSize}"
                    Padding="4,2"
                    Click="AppTile_Click"
                    PreviewMouseLeftButtonDown="AppTile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="AppTile_PreviewMouseMove"
                    AllowDrop="True"
                    Tag="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Pin to StartDock" Click="PinSearchResult_Click" Tag="{Binding}"
                                  Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Run as administrator" Click="RunAsAdmin_Click" Tag="{Binding}"
                                  Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Open file location" Click="OpenFileLocation_Click" Tag="{Binding}"
                                  Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Rename" Click="RenameTile_Click" Tag="{Binding}"
                                  Visibility="{Binding CanCustomize, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Change icon..." Click="ChangeIcon_Click" Tag="{Binding}"
                                  Visibility="{Binding CanCustomize, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Rename folder" Click="RenameFolder_Click" Tag="{Binding}"
                                  Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                        <!-- Re-extracts this tile's icon from scratch, discarding whatever's
                             cached — for a tile whose icon came back blank/generic (seen with
                             some Steam games; see IconExtractor's own comment on why: the
                             shell's icon cache can be cold for a path StartDock reads before
                             Explorer has, especially right after a second drive spins up or
                             mounts) rather than needing to remove and re-add the tile just to
                             force a re-extraction. -->
                        <!-- Also how a custom icon (Change icon...) is undone: it re-extracts
                             the app's own icon, replacing whatever was there. -->
                        <MenuItem Header="Refresh icon" Click="RefreshIcon_Click" Tag="{Binding}"
                                  Visibility="{Binding CanRefreshIcon, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Remove from StartDock" Click="RemoveIcon_Click" Tag="{Binding}"
                                  Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>
                        <!-- Opens Windows' Installed apps page (Settings), where the app
                             can be uninstalled — see Uninstall_Click. -->
                        <MenuItem Header="Uninstall..." Click="Uninstall_Click" Tag="{Binding}"
                                  Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <!-- Centered vertically (rather than the StackPanel default of
                     top-packed-with-leftover-space-below) so a tile whose name
                     label is collapsed — see AppConfig.HideIconNames — reads as a
                     centered icon on a clean square instead of one pinned to the
                     top with empty space trailing beneath it. Makes no visible
                     difference while the name label is showing: the icon+text
                     stack already comes within a couple of pixels of the tile's
                     own full height in that case. -->
                <StackPanel VerticalAlignment="Center">
                    <!-- Vertical space inside a tile is tight — the tile is a fixed IconSize
                         square — so this margin, TileButton's own Padding="4,2" above
                         (overriding AppTileButton's uniform 4, vertical only), and the
                         name label's MaxHeight are all budgeted together in
                         MainWindow.xaml.cs's ComputeIconNameMaxHeight. Keep them in
                         sync: that method assumes 3 above + 3 below this glyph and 2px
                         of padding top and bottom. Trimmed from the original 6/6 and 4
                         so a two-line Bold name fits in full even at smaller tile sizes
                         (e.g. a 74px tile, where the old layout only had room for one
                         line and fell back to "Google Ch…"). -->
                    <Grid Width="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconGlyphSize}"
                          Height="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconGlyphSize}"
                          Margin="0,3,0,3">
                        <Image Source="{Binding IconImage}"
                               local:AnimatedGif.SourcePath="{Binding AnimatedIconPath}"
                               Visibility="{Binding IsSingleIcon, Converter={StaticResource BoolToVis}}"/>

                        <!-- Folder tile: a 2x2 preview of its first few apps' icons,
                             matching how the Windows Start Menu previews a group. -->
                        <Border Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource TileHoverBrush}"
                                CornerRadius="4">
                            <ItemsControl ItemsSource="{Binding PreviewChildren}" Margin="3" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding IconImage}" Margin="1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>
                    <!-- MaxHeight used to be a flat "30" regardless of IconNameFontSize/
                         IconNameFontWeight (both user-adjustable in Settings) — sized
                         tightly enough for the 11pt Normal-weight default that a second
                         wrapped line at Bold (AppConfig.BoldIconNames) rendered right at
                         that edge, clipping its descenders. See MainWindow.xaml.cs's
                         IconNameMaxHeight for the fix: room for two lines is now computed
                         from the actual font size in use, so it stays correct at whatever
                         size/weight combination Settings has picked, not just the default.

                         Height (not MaxHeight): the two-line slot is always reserved, even
                         for a one-line name, so every tile's icon sits at the same height.
                         With MaxHeight a one-line name made the stack shorter, and the
                         centered StackPanel then pushed that tile's icon a few pixels lower
                         than its two-line neighbours. Text stays top-aligned in the slot,
                         so a one-line name sits right under its icon and first lines line
                         up across a row, the way the Windows Start menu lays them out. -->
                    <TextBlock Text="{Binding Name}"
                               FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconNameFontSize}"
                               FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconNameFontWeight}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Height="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconNameMaxHeight}"
                               Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconNameVisibility}"/>
                </StackPanel>
            </Button>
            </Grid>
            <DataTemplate.Triggers>
                <!-- AppConfig.ShowIconBackground + IconBackgroundColor: a persistent,
                     always-visible tile background instead of AppTileButton's normal
                     hover-only one — set as a local value here (rather than in the
                     Style itself, which every AppTileButton in the app shares, not
                     just icon tiles) so it only ever affects IconTileTemplate.
                     IsMouseOver/IsPressed in AppTileButton's own
                     ControlTemplate.Triggers still take over on top of this exactly
                     as before (Theme mode keeps the same color on hover since it's
                     the same brush; Black/White still visibly darken on hover/press,
                     same as any other background color would under that overlay).

                     Three MultiDataTriggers rather than one DataTrigger plus a
                     color-converter, so IconBackgroundColorMode.Theme can stay a
                     plain {DynamicResource TileHoverBrush} reference — declared
                     directly in markup like every other theme-aware color in this
                     window — and pick up a live theme switch automatically, the one
                     thing a C#-computed Brush (the way ApplyBorderStyle's own
                     Black/White choice works) can't do without MainWindow re-running
                     ApplyAppearanceSettings itself. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowIconBackground}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconBackgroundColor}" Value="Theme"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TileBg" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowIconBackground}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconBackgroundColor}" Value="Black"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TileBg" Property="Background" Value="Black"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowIconBackground}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconBackgroundColor}" Value="White"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TileBg" Property="Background" Value="White"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A category's own row of icons: dense flow layout (wraps, no gaps),
             with the same insertion-line/merge-outline drag feedback the old
             free-placement grid had — see FlowGridPanel. Every drag/drop handler
             lives here rather than on the individual tiles, since a drop's
             outcome depends on exactly where in a cell the pointer is (edge =
             insert, center = merge — see FlowGridPanel.GetZoneAt), not just
             which tile it happened to land on. -->
        <ItemsPanelTemplate x:Key="CategoryIconsPanelTemplate">
            <!-- Tag="{Binding}" here (not on the surrounding ItemsControl) resolves
                 to the CategoryViewModel via ordinary DataContext inheritance — the
                 panel is part of the ItemsControl's own template/visual tree, not one
                 of its items, so it inherits the ItemsControl's ambient DataContext
                 (the category) rather than needing anything more explicit. This is
                 how MainWindow's CategoryIcons_DragOver/_DragLeave/_Drop know which
                 category a given panel instance belongs to. -->
            <local:FlowGridPanel AllowDrop="True"
                                  DragOver="CategoryIcons_DragOver"
                                  DragLeave="CategoryIcons_DragLeave"
                                  Drop="CategoryIcons_Drop"
                                  IndicatorBrush="{DynamicResource PrimaryTextBrush}"
                                  Alignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryIconAlignment}"
                                  CellSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconCellSize}"
                                  IsVertical="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IsColumnLayout}"
                                  Tag="{Binding}"/>
        </ItemsPanelTemplate>

        <!-- How the categories themselves are stacked (AppConfig.LayoutDirection):
             one under another in Rows, side by side in Columns. MainWindow.xaml.cs's
             ApplyLayoutDirection switches CategoriesItemsControl between these. -->
        <ItemsPanelTemplate x:Key="CategoriesRowsPanelTemplate">
            <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CategoriesColumnsPanelTemplate">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- The automatic "Recently added" / "Recent files" sections: same flow layout
             and alignment as a category, but no drag-and-drop — they're filled by
             StartDock, not arranged by hand. -->
        <ItemsPanelTemplate x:Key="ReadOnlyIconsPanelTemplate">
            <local:FlowGridPanel IndicatorBrush="{DynamicResource PrimaryTextBrush}"
                                  Alignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconAlignment}"
                                  CellSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=IconCellSize}"/>
        </ItemsPanelTemplate>

        <!-- Search results and a folder's own contents: the plain, always-packed
             flow layout StartDock has always used for these — free reordering by
             drag is only available within a category (see CategoryIconsPanelTemplate
             above), not here. -->
        <ItemsPanelTemplate x:Key="FlowGridPanelTemplate">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- The window itself has no border/shadow (AllowsTransparency lets pixels
         outside these rounded shapes stay fully clear). BackgroundBorder and the
         content Grid right after it are two separate, identically-margined
         siblings rather than parent/child, on purpose — see BackgroundBorder's
         own comment.

         This margin used to be 10 — enough room for BackgroundBorder's own
         DropShadowEffect to bleed into. It's 0 now (was 2, then 1, on the way
         here): "Frost the background" turned out to blur/acrylic-fill this
         window's full rectangular bounds regardless of MainWindow.xaml.cs's
         ApplyWindowRegion (SetWindowRgn doesn't reliably shape DWM's
         blur-behind/acrylic compositing the way it shapes this app's own
         rendering and hit-testing — an undocumented-API limitation, not
         something tunable away, and still true even for the newer, documented
         DWMWA_SYSTEMBACKDROP_TYPE route: its corner rounding follows
         DWMWA_WINDOW_CORNER_PREFERENCE against the window's own true outer
         rect, not this app's tighter SetWindowRgn clip), so whatever room this
         margin leaves is where a faint square-ish acrylic fringe can still show
         up around the rounded card. That fringe is what was reported as "more
         white on the right and bottom than the top and left" — the margin
         itself is a single uniform value with nothing that varies per side
         (same here, in BackgroundBorder.Margin/ContentGrid.Margin below, and in
         ApplyWindowRegion's region math, which reads this exact Margin and
         insets every edge by the same amount), so there's no code-level
         asymmetry here. (The actual right/bottom-only culprit turned out to be
         ApplyWindowRegion sizing its region from DIP math that came out one
         device pixel short of the real window on those two sides — see that
         method.) With no margin at all there's no transparent ring left for the
         backdrop to show through anywhere: the card now covers every pixel of
         the window, and only the rounded corners get cut, by that region. The trade is a shadow that no longer has anywhere to bleed into
         (see BackgroundBorder.Effect's own comment) and TopResizeGrip/
         RightResizeGrip needing to sit mostly over the card's own edge now rather
         than in the margin outside it (see their own comments below). -->
    <Grid>
        <!-- No outline of its own any more — see OutlineBorder below, which draws
             it instead so Background opacity doesn't fade it away. -->
        <Border x:Name="BackgroundBorder"
                Background="{DynamicResource DockBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="8"
                Margin="0">
            <!-- BackgroundOpacity (see MainWindow.xaml.cs ApplyAppearanceSettings)
                 fades this Border's own Opacity — background fill, border outline,
                 and its DropShadowEffect all together, toward fully invisible —
                 without touching the content Grid layered on top of it below,
                 which is a separate element and so stays fully crisp regardless.
                 A single shared Background brush's own Opacity couldn't be used
                 for this instead: DockBackgroundBrush is a DynamicResource shared
                 with SettingsWindow and the power flyout, so fading it here would
                 have faded those too.

                 The DropShadowEffect below has nowhere left to actually bleed
                 into and render: MainWindow.xaml.cs's ApplyWindowRegion clips this
                 whole window to BackgroundBorder's own rect with zero margin for
                 it (see that method's own comment for why), so it's effectively
                 inert now rather than removed outright — cheap to leave in place
                 in case that clip is ever relaxed again, e.g. if the margin above
                 grows back for some other reason. -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black"/>
            </Border.Effect>
        </Border>

        <!-- x:Name="ContentGrid": its RowDefinitions (and every child's Grid.Row
             below) are rebuilt from scratch at runtime by MainWindow.xaml.cs's
             ApplyMenuBarPosition, per AppConfig.MenuBarAtTop — the Auto/*/Auto/Auto
             arrangement below is only the bar-at-bottom default, so this XAML
             renders sanely on its own, but it's overwritten before the dock is
             ever shown (see ApplyAppearanceSettings, called from Initialize).

             Margin matches BackgroundBorder's own (see its comment on why that
             shrank from 10 to 0) — these two stay "identically-margined
             siblings" on purpose, so the visible card and the actual content
             area never drift apart. -->
        <Grid x:Name="ContentGrid" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- search -->
                <RowDefinition Height="*"/>       <!-- icon grid -->
                <RowDefinition Height="Auto"/>   <!-- divider -->
                <RowDefinition Height="Auto"/>   <!-- bottom bar -->
            </Grid.RowDefinitions>

                <!-- Search / filter box. Its own row collapses entirely when
                     HideSearchBar is on and nothing's been typed yet (see
                     MainWindow.xaml.cs UpdateSearchBarVisibility) — the "+" tile that
                     used to live in this row moved to the bottom bar specifically so
                     adding an app doesn't depend on this row being visible. -->
                <Grid x:Name="SearchGrid" Grid.Row="0" Margin="16,16,16,8">
                    <TextBox x:Name="SearchBox"
                             Padding="10,8"
                             FontSize="14"
                             Background="{DynamicResource TileHoverBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0"
                             Text=""
                             TextChanged="SearchBox_TextChanged"
                             VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Type to search your apps"
                               Margin="12,0,0,0"
                               FontSize="14"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Visibility="Visible"/>
                </Grid>

                <!-- Folder header: replaces the search row while browsing inside a
                     folder tile (see MainWindow.xaml.cs OpenFolder/CloseFolder). -->
                <Grid x:Name="FolderHeaderGrid" Grid.Row="0" Margin="16,16,16,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="FolderBackButton" Grid.Column="0"
                            Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE72B;" FontSize="16"
                            Click="FolderBack_Click"
                            ToolTip="Back"/>

                    <TextBox x:Name="FolderNameBox" Grid.Column="1"
                             Padding="10,8"
                             FontSize="14"
                             Background="{DynamicResource TileHoverBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0"
                             Margin="8,0,0,0"
                             VerticalContentAlignment="Center"
                             GotFocus="FolderNameBox_GotFocus"
                             LostFocus="FolderNameBox_LostFocus"
                             KeyDown="FolderNameBox_KeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="2"
                            Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE738;" FontSize="16"
                            Margin="8,0,0,0"
                            Click="UngroupFolder_Click"
                            ToolTip="Ungroup this folder (moves its apps back to the main grid)"/>
                </Grid>

                <!-- Categories view: the dock's default top-level content — a
                     vertical stack of named, independently-wrapping rows (see
                     StartDock.Models.Category / CategoryViewModel). -->
                <ScrollViewer x:Name="CategoriesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,8,0"
                              PreviewMouseWheel="CategoriesScrollViewer_PreviewMouseWheel"
                              PreviewDragOver="CategoriesScrollViewer_PreviewDragOver"
                              ScrollChanged="CategoriesScrollViewer_ScrollChanged">
                    <!-- Two rows: categories at the top, the automatic Recently Added /
                         Recent Files sections at the bottom. MinHeight follows the visible
                         height, so when everything fits the gap opens up between the two
                         and the automatic sections sit right down against the bottom of
                         the dock; once there's more than fits, it all just scrolls as one
                         list with those sections at the end. -->
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=CategoriesScrollViewer}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <StackPanel x:Name="CategoriesStack" Grid.Row="0" Margin="8,8,8,0">
                        <ItemsControl x:Name="CategoriesItemsControl"
                                      ItemsPanel="{StaticResource CategoriesRowsPanelTemplate}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Margin="0,0,0,2" keeps categories reading as one
                                         continuous list — closer to how the Windows 10 Start
                                         Menu packs its own groups — rather than as separate,
                                         widely-spaced blocks. See also FlowGridPanel.EmptyRowHeight,
                                         which closes most of the gap around an empty category
                                         specifically: a brand-new or emptied-out one used to
                                         reserve a full tile-row's worth of blank space even with
                                         nothing in it. -->
                                    <!-- A Grid rather than a StackPanel so that in Columns
                                         (AppConfig.LayoutDirection) the icons row (Row 1) gets
                                         the dock's real height to fill top to bottom; a
                                         StackPanel would hand it unlimited height. In Rows the
                                         categories are stacked, so Row 1 just takes the icons'
                                         own height, the same as before. Margin is the gap to
                                         the next category: below it in Rows, right of it in
                                         Columns (CategoryItemMargin). -->
                                    <Grid Margin="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryItemMargin}">
                                        <!-- Row 0: the name banner (normally). Row 1: the icons.
                                             Row 2: the name banner instead, in Columns with Column
                                             alignment Bottom, so the name sits under its icons at
                                             the bottom of the dock (CategoryBannerRow). -->
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Drop indicators for reordering categories in Columns:
                                             a bar in the gap to the left or right of this one (see
                                             SetCategoryDropIndicator). Rows uses CategoryDropAbove/
                                             CategoryDropBelow in the banner instead. -->
                                        <Border x:Name="CategoryDropBefore" Grid.RowSpan="3"
                                                Width="2" CornerRadius="1"
                                                Margin="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryDropBeforeMargin}"
                                                HorizontalAlignment="Left"
                                                Background="{DynamicResource PrimaryTextBrush}"
                                                Visibility="Collapsed"/>
                                        <Border x:Name="CategoryDropAfter" Grid.RowSpan="3"
                                                Width="2" CornerRadius="1"
                                                Margin="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryDropAfterMargin}"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource PrimaryTextBrush}"
                                                Visibility="Collapsed"/>
                                        <!-- Banner: name (click to rename, like a folder's header)
                                             plus a delete button that only ever appears for an
                                             empty category, and even then only on hover — see the
                                             MultiDataTrigger below. The banner itself is also the
                                             drag handle for reordering whole categories (see
                                             CategoryBanner_PreviewMouseMove).

                                             Wrapped in an outer 3-row Grid so a category-reorder
                                             drag has somewhere to paint "drop above"/"drop below"
                                             feedback (the two thin indicator Borders in rows 0 and
                                             2) without disturbing the banner's own content in row
                                             1, which is where all the actual drag/drop handlers are
                                             wired — see CategoryBanner_DragOver/SetCategoryDropIndicator
                                             in MainWindow.xaml.cs, which reaches these two Borders by
                                             name from the content Grid via FindName, since a
                                             DataTemplate instance shares one name scope across
                                             everything inside it. -->
                                        <Grid Grid.Row="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerRow}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="2"/>
                                            </Grid.RowDefinitions>

                                            <Border x:Name="CategoryDropAbove" Grid.Row="0"
                                                    Height="2" Margin="4,0" CornerRadius="1"
                                                    Background="{DynamicResource PrimaryTextBrush}"
                                                    Visibility="Collapsed"/>

                                            <!-- The banner used to end in a small hover-only "×" delete
                                                 Button (Grid.Column="1", visible only while empty and
                                                 moused-over) — replaced with a right-click context menu
                                                 (see the TextBox's own ContextMenu below) carrying both
                                                 Rename and Remove, so there's now just the one column,
                                                 the name box, filling the whole banner. -->
                                            <Grid Grid.Row="1" Height="24" Margin="4,0,4,1"
                                                  Background="Transparent"
                                                  AllowDrop="True"
                                                  Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerVisibility}"
                                                  PreviewMouseLeftButtonDown="CategoryBanner_PreviewMouseLeftButtonDown"
                                                  PreviewMouseMove="CategoryBanner_PreviewMouseMove"
                                                  DragOver="CategoryBanner_DragOver"
                                                  DragLeave="CategoryBanner_DragLeave"
                                                  Drop="CategoryBanner_Drop"
                                                  Tag="{Binding}">
                                                <!-- TextAlignment follows the same IconAlignment setting
                                                     that packs each category's own icon row Left/Center/
                                                     Right (see MainWindow.xaml.cs's CategoryNameAlignment,
                                                     computed in ApplyAppearanceSettings) — the banner's
                                                     name now sits above wherever that row's content
                                                     actually is instead of always pinned to the left.

                                                     ContextMenu is set directly on this TextBox (replacing
                                                     its default Cut/Copy/Paste menu — a short category name
                                                     doesn't lean on that, and Ctrl+X/C/V still work
                                                     regardless) rather than on the outer Grid: the TextBox
                                                     already fills virtually the whole banner width, so a
                                                     Grid-level ContextMenu would rarely actually be reachable
                                                     by a right-click landing on it instead. MenuItem
                                                     Tag="{Binding}" below resolves correctly to this
                                                     category's own CategoryViewModel because WPF's
                                                     FrameworkElement.ContextMenu specifically inherits
                                                     DataContext from its owner even though it renders in a
                                                     separate Popup visual root — the same mechanism the icon
                                                     tiles' own context menus already rely on (see
                                                     IconTileTemplate above). -->
                                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryFontSize}"
                                                         FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameFontWeight}"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerAlignment}"
                                                         Padding="4,0"
                                                         VerticalContentAlignment="Center"
                                                         Cursor="IBeam"
                                                         GotFocus="CategoryNameBox_GotFocus"
                                                         LostFocus="CategoryNameBox_LostFocus"
                                                         KeyDown="CategoryNameBox_KeyDown">
                                                    <TextBox.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Rename Category" Click="RenameCategoryMenuItem_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="Remove Category" Click="DeleteCategory_Click" Tag="{Binding}"
                                                                      IsEnabled="{Binding IsEmpty}"
                                                                      ToolTip="Only while empty — drag its apps out (or into another category) first"/>
                                                        </ContextMenu>
                                                    </TextBox.ContextMenu>
                                                </TextBox>
                                            </Grid>

                                            <Border x:Name="CategoryDropBelow" Grid.Row="2"
                                                    Height="2" Margin="4,0" CornerRadius="1"
                                                    Background="{DynamicResource PrimaryTextBrush}"
                                                    Visibility="Collapsed"/>
                                        </Grid>

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Icons}"
                                                      HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryIconsHorizontalAlignment}"
                                                      ItemsPanel="{StaticResource CategoryIconsPanelTemplate}"
                                                      ItemTemplate="{StaticResource IconTileTemplate}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Dragging an icon down into this strip creates a brand-new
                             category and drops it there (see NewCategoryDropZone_Drop) —
                             the gesture the user asked for, alongside the explicit button
                             below for starting an empty category with nothing to drag yet. -->
                        <Border x:Name="NewCategoryDropZone"
                                Height="36" Margin="4,0,4,8"
                                Background="Transparent"
                                CornerRadius="6"
                                AllowDrop="True"
                                DragOver="NewCategoryDropZone_DragOver"
                                DragLeave="NewCategoryDropZone_DragLeave"
                                Drop="NewCategoryDropZone_Drop"/>

                        <!-- Hidden for now (to be moved somewhere else later) — the
                             drag-past-the-last-category gesture (NewCategoryDropZone above)
                             still covers category creation on its own in the meantime. The
                             button and its Click handler (AddCategory_Click, MainWindow.xaml.cs)
                             are both left in place, just not wired into the layout, so bringing
                             this back is a matter of uncommenting rather than rebuilding it.
                        <Button x:Name="AddCategoryButton"
                                Content="+ Add category"
                                HorizontalAlignment="Left"
                                Margin="4,0,4,4"
                                Padding="10,6"
                                Style="{StaticResource AppTileButton}"
                                Click="AddCategory_Click"/>
                        -->
                    </StackPanel>

                    <!-- In Columns this stays put while the categories scroll sideways:
                         MainWindow.xaml.cs's UpdateAutoSectionsPin keeps it the visible
                         width and shifts it along with the scroll position. -->
                    <StackPanel x:Name="AutoSectionsPanel" Grid.Row="1" Margin="8,0,8,4" VerticalAlignment="Bottom">
                        <!-- Automatic sections at the bottom (AppConfig.ShowNewApps /
                             ShowRecentApps / ShowRecentFiles) — read-only, filled each time the dock opens
                             (see MainWindow.xaml.cs UpdateAutoSections). Headers match the
                             category banners' font settings so they read as categories. -->
                        <StackPanel Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=NewAppsVisibility}"
                                    Margin="0,0,0,2">
                            <TextBlock Text="Recently Added" Margin="8,0,8,1" Height="24" Padding="0,2,0,0"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryFontSize}"
                                       FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameFontWeight}"
                                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameAlignment}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerVisibility}"/>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=NewAppTiles}"
                                          ItemsPanel="{StaticResource ReadOnlyIconsPanelTemplate}"
                                          ItemTemplate="{StaticResource IconTileTemplate}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=RecentAppsVisibility}"
                                    Margin="0,0,0,2">
                            <TextBlock Text="Recently Used" Margin="8,0,8,1" Height="24" Padding="0,2,0,0"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryFontSize}"
                                       FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameFontWeight}"
                                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameAlignment}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerVisibility}"/>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=RecentAppTiles}"
                                          ItemsPanel="{StaticResource ReadOnlyIconsPanelTemplate}"
                                          ItemTemplate="{StaticResource IconTileTemplate}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=RecentFilesVisibility}"
                                    Margin="0,0,0,2">
                            <TextBlock Text="Recent Files" Margin="8,0,8,1" Height="24" Padding="0,2,0,0"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryFontSize}"
                                       FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameFontWeight}"
                                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameAlignment}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerVisibility}"/>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=RecentFileTiles}"
                                          ItemsPanel="{StaticResource ReadOnlyIconsPanelTemplate}"
                                          ItemTemplate="{StaticResource IconTileTemplate}"/>
                        </StackPanel>

                        <!-- All three in one section (AppConfig.CombineRecentSections). -->
                        <StackPanel Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CombinedRecentVisibility}"
                                    Margin="0,0,0,2">
                            <TextBlock Text="Recent" Margin="8,0,8,1" Height="24" Padding="0,2,0,0"
                                       FontSize="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryFontSize}"
                                       FontWeight="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameFontWeight}"
                                       TextAlignment="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryNameAlignment}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CategoryBannerVisibility}"/>
                            <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=CombinedRecentTiles}"
                                          ItemsPanel="{StaticResource ReadOnlyIconsPanelTemplate}"
                                          ItemTemplate="{StaticResource IconTileTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Flat view: search results or an open folder's contents — no
                     categories, no free reordering by drag, exactly as before. -->
                <ScrollViewer x:Name="FlatScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,8,0" Visibility="Collapsed">
                    <ItemsControl x:Name="IconItemsControl" Margin="8"
                                  ItemsPanel="{StaticResource FlowGridPanelTemplate}"
                                  ItemTemplate="{StaticResource IconTileTemplate}"/>
                </ScrollViewer>

                <!-- Empty-state hint, shown when there are no icons pinned anywhere yet -->
                <TextBlock x:Name="EmptyStateText"
                           Grid.Row="1"
                           Text="No apps pinned yet.&#10;Click the + next to the search box to add one."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

                <Border x:Name="DividerBorder" Grid.Row="2" Height="1" Background="{DynamicResource DividerBrush}" Margin="16,4,16,4"
                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=DividerVisibility}"/>

                <!-- Menu bar: user, task manager, volume mixer, file explorer, settings, power.
                     Can sit on any edge of the dock — bottom (default), top, left or right —
                     with its button order optionally reversed: see AppConfig.MenuBarPosition /
                     FlipMenuBarOrder and MainWindow.xaml.cs's ApplyMenuBarPosition, which
                     moves this whole Grid (and DividerBorder above, which always stays between
                     it and the icon-grid content) and lays its buttons out along the bar. The
                     Grid.Column values below are the default bottom/top layout.

                     Visibility here (and DividerBorder's own, right above) is the master
                     AppConfig.HideMenuBar switch — collapses the whole bar regardless of which
                     individual ShowTaskManagerButton/etc. buttons below are themselves on, and
                     regardless of which side MenuBarAtTop currently has it sitting on.

                     Deliberately has no Background/Border of its own any more — it used to (an
                     earlier pass gave it its own DockBackgroundBrush-filled Border, matching the
                     rest of the dock's color but still a second, separately-drawn rounded
                     rectangle), but stacking two same-colored fills right at their shared edge
                     is exactly what read as a faint seam rather than one continuous panel.
                     BackgroundBorder (above, spanning the dock's entire height) already sits
                     directly behind this Grid too, so leaving this Grid transparent lets that
                     single shared surface show straight through — genuinely one background,
                     not two that happen to match — and its existing CornerRadius="8" (the same
                     on all four corners, always) already rounds whichever edge the bar ends up
                     against without needing to flip anything here. BackgroundOpacity fading
                     BackgroundBorder alone is therefore now enough to fade the bar's background
                     too, for the same reason — no separate Opacity to keep in sync. -->
                <Grid x:Name="MenuBarRow" Grid.Row="3" Height="52"
                      Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=MenuBarVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- HorizontalAlignment="Left": this button sits in the bar's one
                         stretching ("*") column, so without it the button — and its
                         hover highlight — filled all the empty space up to the "+",
                         showing as a long rectangle instead of a square around the
                         avatar. The column still stretches; only the button hugs its
                         content now. -->
                    <Button x:Name="UserButtonElement" Grid.Column="0" Style="{StaticResource AppTileButton}"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left" Margin="8,4,4,4"
                            Click="UserButton_Click"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowUserButton}">
                        <!-- Avatar only — the signed-in user's name is still available as
                             this button's ToolTip rather than shown inline (see RefreshUserInfo).
                             HorizontalAlignment is explicit here because AppTileButton's
                             ControlTemplate doesn't wire HorizontalContentAlignment through to
                             its ContentPresenter — without it, a fixed-width child like this
                             ends up centered in the button (which spans the whole bottom-bar
                             column) instead of pinned to the left, next to the avatar's icons. -->
                        <Border Width="28" Height="28" CornerRadius="14" Margin="4,0,4,0" ClipToBounds="True"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           x:Name="UserGlyphFallback"/>
                                <Image x:Name="UserAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Button>

                    <!-- Moved here from the search row (see SearchGrid above) so adding
                         an app doesn't depend on the search row being visible, now that
                         HideSearchBar can collapse it entirely. -->
                    <Button x:Name="AddTileButton" Grid.Column="1"
                            Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE710;" ToolTip="Add an app, file, or folder to StartDock"
                            Click="AddTile_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowAddButton}"/>

                    <!-- Opens the real, native Windows Start Menu (see AppLauncher.
                         OpenNativeStartMenu) — for anyone StartDock is redistributed to
                         who still wants a way back to it, since ReplaceStartButton/
                         HotkeyService otherwise intercept every Win press and taskbar
                         Start-button click and send them here instead. Hideable via
                         Settings (AppConfig.ShowNativeStartMenuButton) for anyone who'd
                         rather the bar stay exactly as it was.

                         Its glyph is a plain 2x2 square grid rather than Microsoft's own
                         flag logo: Segoe Fluent Icons/Segoe MDL2 Assets (see Styles.xaml's
                         IconFont) doesn't expose the Windows logo itself as a public
                         glyph, and there's no Windows machine available here to check an
                         undocumented private codepoint against — so this stays a
                         generic, safe stand-in rather than a guess that might render as a
                         broken box. Swap in a bitmap Image (e.g. an icon extracted via
                         IconExtractor) instead if you'd rather ship the literal logo. -->
                    <Button x:Name="NativeStartMenuButton" Grid.Column="2"
                            Style="{StaticResource BottomBarIconButton}"
                            ToolTip="Open the Windows Start Menu"
                            Click="NativeStartMenuButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowNativeStartMenuButton}">
                        <UniformGrid Rows="2" Columns="2" Width="16" Height="16">
                            <Border Background="{DynamicResource SecondaryTextBrush}" Margin="1" CornerRadius="1"/>
                            <Border Background="{DynamicResource SecondaryTextBrush}" Margin="1" CornerRadius="1"/>
                            <Border Background="{DynamicResource SecondaryTextBrush}" Margin="1" CornerRadius="1"/>
                            <Border Background="{DynamicResource SecondaryTextBrush}" Margin="1" CornerRadius="1"/>
                        </UniformGrid>
                    </Button>

                    <Button x:Name="TaskManagerButtonElement" Grid.Column="3" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE9D9;" ToolTip="Task Manager" Click="TaskManagerButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowTaskManagerButton}"/>

                    <Button x:Name="VolumeMixerButtonElement" Grid.Column="4" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE9E9;" ToolTip="Volume Mixer" Click="VolumeMixerButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowVolumeMixerButton}"/>

                    <Button x:Name="FileExplorerButtonElement" Grid.Column="5" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE838;" ToolTip="File Explorer" Click="FileExplorerButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowFileExplorerButton}"/>

                    <Button x:Name="CalculatorButtonElement" Grid.Column="6" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE8EF;" ToolTip="Calculator" Click="CalculatorButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowCalculatorButton}"/>

                    <Button x:Name="SettingsButtonElement" Grid.Column="7" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE713;" ToolTip="Settings" Click="SettingsButton_Click" Margin="0,0,4,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowSettingsButton}"/>

                    <Button x:Name="PowerButtonElement" Grid.Column="8" Style="{StaticResource BottomBarIconButton}"
                            Content="&#xE7E8;" ToolTip="Power" Click="PowerButton_Click" Margin="0,0,10,0"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=local:MainWindow}, Path=ShowPowerButton}"/>
                </Grid>
            </Grid>

        <!-- The dock's outline. Used to be BackgroundBorder's own BorderBrush, which
             meant Background opacity (BackgroundBorder.Opacity) faded it along with
             the fill — at a low opacity even a Bold border all but disappeared while
             the menu bar's divider line, which isn't faded, stayed bright. As its
             own sibling (same CornerRadius, painted over the content's edge) it
             stays at full strength regardless of opacity. Styled entirely by
             MainWindow.xaml.cs's ApplyBorderStyle (Hide/Bold border settings).
             Not hit-testable, so it never interferes with clicks near the edge. -->
        <Border x:Name="OutlineBorder"
                BorderBrush="{DynamicResource DockBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"/>

        <!-- Resize grips: drag the top edge to change height (bottom stays anchored),
             drag the right edge to change width. Transparent and invisible at rest —
             just hit-testable — but each shows a faint highlight strip on hover (see
             the Style/Trigger below on each) regardless of AppConfig.BackgroundOpacity,
             which BackgroundBorder alone is faded by (see MainWindow.xaml.cs's
             ApplyAppearanceSettings) — these two Borders are separate siblings, not
             children of it, and sit later in this Grid so they already paint on top
             of it. At 0% background opacity the rest of the dock is intentionally
             fully invisible, but there'd otherwise be no way to even find these two
             10px-wide edge strips to grab in the first place; hovering (not clicking)
             is enough to reveal exactly where they are without permanently showing
             any chrome the 0%-opacity setting was specifically asked for. Background
             is set only via each Style below now, not as a plain attribute here
             directly — a local attribute value would out-rank the Style's own
             IsMouseOver Setter (local values always beat style setters in WPF), which
             would silently make the hover highlight never actually show.

             Both used to sit mostly in the 10px margin outside BackgroundBorder,
             straddling its edge. Now that margin has shrunk to 2px (see
             BackgroundBorder's own comment on why), there's nowhere near enough
             room out there for a 10px grip any more, so each now sits flush
             against its own edge of the *window* instead and reaches inward over
             the card's own content — invisible at rest either way, so this isn't
             a visual change, but it does mean they're now Z-ordered on top of
             real, clickable content near that edge for the first time. -->
        <Border x:Name="TopResizeGrip" Height="10" VerticalAlignment="Top" Margin="10,0,10,0"
                Cursor="SizeNS"
                MouseLeftButtonDown="TopResizeGrip_MouseLeftButtonDown"
                MouseMove="TopResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Margin.Top/Bottom="70" (rather than a small, symmetric value like
             TopResizeGrip's own left/right 10) is deliberate: it keeps this grip
             clear of the menu bar's own icon row — 52px tall plus the divider —
             at whichever end that bar currently sits (AppConfig.MenuBarAtTop can
             put it at either the top or the bottom of the dock), so it can never
             sit on top of a real, clickable menu-bar button. That's a hard
             requirement now that this grip reaches over real content instead of
             empty margin (see the shared comment above) — a resize-vs-click
             conflict right on a menu-bar icon would be a lot more noticeable than
             losing a *little* grabbable length at the very top and bottom of the
             remaining edge, which is still most of the window's height either
             way. -->
        <Border x:Name="RightResizeGrip" Width="10" HorizontalAlignment="Right" Margin="0,70,0,70"
                Cursor="SizeWE"
                MouseLeftButtonDown="RightResizeGrip_MouseLeftButtonDown"
                MouseMove="RightResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Power flyout -->
        <Popup x:Name="PowerFlyoutPopup" PlacementTarget="{Binding ElementName=PowerButtonElement}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource DockBackgroundBrush}"
                    BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="4" MinWidth="180">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Button Content="Lock" Style="{StaticResource AppTileButton}" HorizontalContentAlignment="Left" Padding="10,8" Click="Lock_Click"/>
                    <Button Content="Sleep" Style="{StaticResource AppTileButton}" HorizontalContentAlignment="Left" Padding="10,8" Click="Sleep_Click"/>
                    <Button Content="Sign out" Style="{StaticResource AppTileButton}" HorizontalContentAlignment="Left" Padding="10,8" Click="SignOut_Click"/>
                    <Button x:Name="RestartButton" Content="Restart" Style="{StaticResource AppTileButton}" HorizontalContentAlignment="Left" Padding="10,8" Click="Restart_Click"/>
                    <Button x:Name="ShutDownButton" Content="Shut down" Style="{StaticResource AppTileButton}" HorizontalContentAlignment="Left" Padding="10,8" Click="ShutDown_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
