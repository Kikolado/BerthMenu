<Window x:Class="StartDock.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- A themed yes/no question (ConfirmDialog.Ask) — used before removing a
         category or a customized tile. Esc or Cancel says no. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" Padding="10,3" Margin="0,0,8,0" IsCancel="True" IsDefault="True"/>
            <Button x:Name="ConfirmButton" MinWidth="80" Padding="10,3" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
