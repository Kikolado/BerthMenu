<Window x:Class="StartDock.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to StartDock"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Shown once, the first time StartDock runs (or after Settings → Reset) —
         see App.ShowWelcome and WelcomeWindow.xaml.cs. Everything here can be
         changed later in Settings. -->
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Welcome to StartDock" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="A few choices to get you started. You can change all of them later in Settings."/>

        <TextBlock Text="Open StartDock with" Style="{StaticResource Label}"/>
        <RadioButton x:Name="WindowsKeyRadio" GroupName="Hotkey" Content="The Windows key" IsChecked="True"/>
        <RadioButton x:Name="ShiftWindowsKeyRadio" GroupName="Hotkey" Content="Shift + Windows key"/>
        <CheckBox x:Name="StartButtonCheck" Content="The taskbar's Start button opens StartDock" IsChecked="True" Margin="0,4,0,4"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Where it opens" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <!-- Same order as Settings → Layout → Dock Position. -->
                <ComboBox x:Name="PositionCombo" SelectedIndex="7">
                    <ComboBoxItem Content="Top left"/>
                    <ComboBoxItem Content="Top center"/>
                    <ComboBoxItem Content="Top right"/>
                    <ComboBoxItem Content="Middle left"/>
                    <ComboBoxItem Content="Middle center"/>
                    <ComboBoxItem Content="Middle right"/>
                    <ComboBoxItem Content="Bottom left"/>
                    <ComboBoxItem Content="Bottom center"/>
                    <ComboBoxItem Content="Bottom right"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Look" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ThemeCombo" SelectedIndex="0">
                    <ComboBoxItem Content="Match Windows"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                <TextBlock Text="Icon direction" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="DirectionCombo" SelectedIndex="0" SelectionChanged="DirectionCombo_SelectionChanged">
                    <ComboBoxItem Content="Rows (across)"/>
                    <ComboBoxItem Content="Columns (down)"/>
                </ComboBox>
            </StackPanel>
            <!-- Row alignment for Rows, Column alignment for Columns, like Settings. -->
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock x:Name="AlignmentLabel" Text="Row alignment" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="RowAlignmentCombo" SelectedIndex="0">
                    <ComboBoxItem Content="Left"/>
                    <ComboBoxItem Content="Center"/>
                    <ComboBoxItem Content="Right"/>
                </ComboBox>
                <ComboBox x:Name="ColumnAlignmentCombo" SelectedIndex="0" Visibility="Collapsed">
                    <ComboBoxItem Content="Top"/>
                    <ComboBoxItem Content="Center"/>
                    <ComboBoxItem Content="Bottom"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="Start with" Style="{StaticResource Label}"/>
        <RadioButton x:Name="MostUsedRadio" GroupName="Fill" IsChecked="True"
                     Content="The apps I use most (StartDock pins them for you)"/>
        <RadioButton x:Name="EmptyRadio" GroupName="Fill" Content="An empty dock. I'll add my own"/>

        <CheckBox x:Name="AutoStartCheck" Content="Start StartDock when I sign in" IsChecked="True" Margin="0,12,0,0"/>

        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource TileHoverBrush}">
            <StackPanel>
                <TextBlock Text="Good to know" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Text="• Just start typing after opening StartDock to search."/>
                <TextBlock TextWrapping="Wrap" Text="• Right-click an empty part of the dock to add apps, folders or websites, or drag them in."/>
                <TextBlock TextWrapping="Wrap" Text="• More tips: right-click StartDock's icon next to the clock → Tips."/>
            </StackPanel>
        </Border>

        <Button Content="Get started" HorizontalAlignment="Right" MinWidth="110" Padding="14,5" Margin="0,18,0,0"
                IsDefault="True" Click="GetStarted_Click"/>
    </StackPanel>
</Window>
