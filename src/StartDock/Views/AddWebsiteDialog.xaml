<Window x:Class="StartDock.Views.AddWebsiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a website"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource DockBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <!-- Add → "Add a website...": a tile that opens an address in the default
         browser (see MainWindow.AddWebsite). Enter adds, Esc cancels. -->
    <StackPanel Margin="16">
        <TextBlock Text="Address" Margin="0,0,0,6"/>
        <TextBox x:Name="AddressBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"
                 TextChanged="AddressBox_TextChanged"/>
        <TextBlock Text="Name" Margin="0,12,0,6"/>
        <TextBox x:Name="NameBox" Padding="6,4" Style="{StaticResource ThemedTextBox}"
                 TextChanged="NameBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#E05252" FontSize="12"
                   Text="Enter an address like example.com or https://example.com." Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Padding="0,3" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Add" Width="80" Padding="0,3" IsDefault="True" Click="Add_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
