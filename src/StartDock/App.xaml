<Application x:Class="StartDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode="OnExplicitShutdown": StartDock is a background/tray app. It has no
        "main window" in the normal sense — the dock window is created once and then
        shown/hidden on demand, and closing it must NOT exit the process. The app only
        quits when the user picks "Exit" from the tray icon menu.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the swappable theme dictionary — App.ApplyTheme() replaces
                     just this entry to switch light/dark at runtime. Keep it first. -->
                <ResourceDictionary Source="Resources/Theme.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
