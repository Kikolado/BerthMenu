<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>StartDock</RootNamespace>
    <AssemblyName>StartDock</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- used only for the NotifyIcon (system tray) helper -->
    <Nullable>enable</Nullable>
    <!-- Deliberately OFF: this project mixes UseWPF and UseWindowsForms (for the tray
         icon), and the SDK's implicit global usings for both frameworks collide on
         type names like Application, MessageBox, Button, and OpenFileDialog. Every
         file below uses explicit `using` directives instead. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 is a Windows Forms analyzer warning asking for DPI settings to move
         out of app.manifest into Application.SetHighDpiMode. That's WinForms-only
         advice: this is a WPF app (WinForms is used just for the tray icon), and
         WPF reads its DPI awareness from the manifest, so the manifest is correct. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- The .exe's own icon — shown in Explorer, Alt-Tab/taskbar if ever pinned
         despite ShowInTaskbar="False", UAC prompts, and reused at runtime for the
         tray icon (see TrayIconService.LoadAppIcon) so there's one source of truth
         for StartDock's branding rather than two icons to keep in sync. -->
    <ApplicationIcon>Resources\StartDock.ico</ApplicationIcon>
    <Platforms>x64;x86;arm64</Platforms>
    <SelfContained>false</SelfContained>
    <!-- Only takes effect on a `-p:PublishSingleFile=true` publish (a normal build/
         debug run ignores it) — without it, WPF's own native support DLLs
         (PresentationNative_x64.dll, wpfgfx_cor3.dll, D3DCompiler_47_cor3.dll,
         vcruntime140_cor3.dll) are left as loose files sitting next to the published
         .exe rather than embedded inside it. Since the whole point of a single-file
         publish here is a single portable .exe to hand someone else, leaving those
         out means the app throws a DllNotFoundException from deep inside WPF's own
         HwndSubclass/WndProc plumbing the moment it's run anywhere those sibling
         DLLs didn't also get copied along — exactly what happened testing on a
         second machine after transferring only the .exe itself. This bakes the
         native libraries into the bundle instead, so the published .exe is truly
         standalone. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.9.5.2</Version>
    <Company>Roberto Regalado</Company>
    <Product>StartDock</Product>
    <Description>A lightweight, resizable icon-dock replacement for the Windows 11 Start Menu.</Description>
  </PropertyGroup>

  <!-- UIAutomationClient/UIAutomationTypes (used to precisely locate the taskbar's
       Start button — see StartButtonOverlayService) are already referenced
       automatically because UseWPF is true; no explicit <Reference> is needed, and
       adding one causes an assembly-version resolution conflict at build time. -->

  <!-- The release notes and tips, shown in StartDock's "What's new" and "Tips" windows (Services/Changelog.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="StartDock.CHANGELOG.md" Link="CHANGELOG.md" />
    <EmbeddedResource Include="Resources\Tips.md" LogicalName="StartDock.Tips.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Reads Windows' own search index for file search (see FileSearchService). -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
  </ItemGroup>

</Project>
